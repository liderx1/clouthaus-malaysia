# Payload
PAYLOAD_SECRET=            # a long random string (e.g. openssl rand -hex 32)

# Supabase Postgres. Vercel: Transaction pooler (port 6543). Local dev and migrations: Session pooler.
DATABASE_URI=
DATABASE_URI_MIGRATE=      # Session pooler connection, used by `payload migrate` during the build

# Supabase Storage (S3-compatible) for uploaded images
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
