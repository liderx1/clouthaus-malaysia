{
  // Type-checks the 3D map's JavaScript (JSDoc types). core/ is held to strict mode; the scene code to the basic checks.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": [],
    "skipLibCheck": true
  },
  "include": ["src/map/**/*.js", "src/map/build-flags.d.ts"]
}
